# Internes Audit-Tool — Schlüssel nie committen.
# Nur für Konten verwenden, die der Kunde besitzt oder verwaltet.

SCRAPECREATORS_API_KEY=
AUDD_TOKEN=

# Web-UI (Render / uvicorn). Unbedingt setzen, sonst ist die Oberfläche offen.
SCANNER_PASSWORD=

# Komma-getrennte Allowlist. Standard: nur krapfbau. Keine fremden Profile.
ALLOWED_HANDLES=krapfbau

# Optional, falls AudD keinen Treffer liefert:
# ACRCLOUD_HOST=identify-eu-west-1.acrcloud.com
# ACRCLOUD_ACCESS_KEY=
# ACRCLOUD_ACCESS_SECRET=
